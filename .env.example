# Calnivo environment variables — copy this file to `.env` and fill in values.
# All variables are OPTIONAL. The 40 calculators run 100% client-side and
# need no backend, so none of these are required for the app to work.

# --- Next.js ---
NEXT_PUBLIC_SITE_URL=https://calnivocalc.com

# --- Firebase (OPTIONAL — only if you add auth / cloud sync later) ---
# Create a project at https://console.firebase.google.com, then copy the
# web app config. All Firebase client vars must be prefixed with NEXT_PUBLIC_
# so they are exposed to the browser.
# NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
# NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
