# Calnivo environment variables — copy this file to `.env` and fill in values.
#
# All variables are OPTIONAL. The 40 calculators run 100% client-side and
# need NO backend, NO database, and NO authentication. The site is free
# with no sign-up required — by design.

# --- Next.js ---
NEXT_PUBLIC_SITE_URL=https://calnivocalc.com
