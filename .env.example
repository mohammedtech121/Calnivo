# Calnivo environment variables — copy this file to `.env` and fill in values.
#
# The 40 calculators run 100% client-side and need NONE of these to work.
# Firebase is only used for the optional Sign-in / account feature.
# If Firebase vars are missing, the Sign-in button shows a friendly
# "unavailable" message and the rest of the site works normally.

# --- Next.js ---
NEXT_PUBLIC_SITE_URL=https://calnivocalc.com

# --- Firebase Auth (REQUIRED for the Sign-in feature to work) ---
# 1. Go to https://console.firebase.google.com → Add project
# 2. Project settings → General → Your apps → Web app (</>)
# 3. Copy the config values below
# 4. Enable sign-in methods: Authentication → Sign-in method →
#    Email/Password = ON, Google = ON
# 5. For production, add your domain (calnivocalc.com) under
#    Authentication → Settings → Authorized domains
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
